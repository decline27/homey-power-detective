{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": ".homeybuild",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": ["app.ts", "api.ts", "src/**/*", "drivers/**/*", "types/**/*"],
  "exclude": ["node_modules", "test", ".homeybuild", ".benchbuild"]
}
